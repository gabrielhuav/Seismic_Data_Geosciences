paper/drafts/
# Only the two final manuscript files above are public; authoring inputs stay local.
paper/figures/
paper/templates/*.docx
# Preserve original scientific bytes locally until source-specific release rights
# and the exact archival deposit have been reviewed.
data/raw/
.env
.env.*
!.env.example
credentials*.json
*.pem
*.key

# Local runtimes and editor state
.venv/
venv/
__pycache__/
*.py[cod]
node_modules/
.DS_Store
Thumbs.db
~$*
